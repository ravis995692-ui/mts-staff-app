<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the app starts: school crest on navy -->
    <style name="Theme.MTS.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.MTS</item>
    </style>

    <style name="Theme.MTS" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorPrimaryDark">@color/navy</item>
        <item name="colorAccent">@color/red</item>
        <item name="android:windowBackground">@color/page_bg</item>
    </style>
</resources>
